{
    "name": "Dixlase SEO",
    "package_name": "plugins/dixlase-seo",
    "slug": "dixlase-seo",
    "version": "1.0.0",
    "description": "SEO optimization plugin for Dixlase CMS. Provides meta tags, OGP, JSON-LD, XML sitemap, and robots.txt management.",
    "author": "",
    "email": "your-email@example.com",
    "url": "https://example.com",
    "license": "GPL-3.0",
    "license_template": "license-gpl.txt",
    "thumbnail": "thumbnail.png",
    "namespace": "Plugins\\DixlaseSEO",
    "providers": [
        "Plugins\\DixlaseSEO\\App\\Providers\\DixlaseSEOServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "general",
    "tags": [
        "custom"
    ],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": false,
        "helper_functions": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": true
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": false,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": true,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "csp": {
            "external_resources": true
        },
        "_optional": [],
        "_notes": {
            "ja": "SEOメタタグ注入のためにwebミドルウェアグループにミドルウェアを登録。サイトマップ・robots.txtのフロントルートを追加。コア設定（サイト名等）を読み取り、プラグイン独自の設定テーブルに書き込み。Google Analytics設定時にgoogletagmanager.com/google-analytics.comへの外部スクリプトを埋め込み、CSPディレクティブを動的登録。",
            "en": "Registers middleware to the web middleware group for SEO meta tag injection. Adds front routes for sitemap.xml and robots.txt. Reads core settings (site name, etc.) and writes to plugin's own settings table. Embeds external scripts to googletagmanager.com/google-analytics.com when GA is configured, with dynamic CSP directive registration."
        }
    },
    "declares": {
        "configs": {
            "roles": true,
            "database_cleanup": false,
            "navigation": true
        },
        "contracts": [
            "App\\Contracts\\CspPolicyProvider"
        ],
        "migrations": true,
        "commands": false,
        "middleware": true
    },
    "files": {},
    "signing": {
        "algo": "ed25519",
        "key_id": null,
        "signed_at": null
    }
}