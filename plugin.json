{
    "name": "Dixlase SEO",
    "package_name": "dixlase/dixlase-seo",
    "slug": "dixlase-seo",
    "version": "0.1.0",
    "description": {
        "en": "SEO optimization plugin for Dixlase. Provides meta tags, OGP, JSON-LD, XML sitemap, and robots.txt management.",
        "ja": "Dixlase用SEO最適化プラグイン。メタタグ、OGP、JSON-LD、XMLサイトマップ、robots.txtの管理機能を提供します。"
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": false,
        "file": "LICENSE-COMMERCIAL",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "thumbnail": "thumbnail.png",
    "namespace": "Plugins\\DixlaseSEO",
    "providers": [
        "Plugins\\DixlaseSEO\\App\\Providers\\DixlaseSEOServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "general",
    "tags": [
        "custom"
    ],
    "capabilities": [
        "seo",
        "multilingual-content"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-seo:settings",
                "cardinality": "singleton",
                "provider": "Plugins\\DixlaseSEO\\App\\Multilingual\\SeoSettingsProvider",
                "label_key": "dixlase-seo::multilingual_types.settings",
                "fields": [
                    {
                        "name": "default_description",
                        "type": "textarea",
                        "rules": "nullable|string|max:300"
                    }
                ]
            }
        ]
    },
    "requires": {
        "dixlase": "^0.1.0",
        "dixlase_api": "^0.1",
        "php": ">=8.3"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": false,
        "helper_functions": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": [],
            "core_tables_read": [
                "media"
            ],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": false,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": true,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "csp": {
            "external_resources": true
        },
        "_optional": [],
        "_notes": {
            "ja": "SEOメタタグ注入のためにwebミドルウェアグループにミドルウェアを登録。サイトマップ・robots.txtのフロントルートを追加。コア設定（サイト名等）を読み取り、プラグイン独自の設定テーブルに書き込み。OGP画像・組織ロゴのメディアID解決のためmediaテーブルを読み取り。Google Analytics設定時にgoogletagmanager.com/google-analytics.comへの外部スクリプトを埋め込み、CSPディレクティブを動的登録。",
            "en": "Registers middleware to the web middleware group for SEO meta tag injection. Adds front routes for sitemap.xml and robots.txt. Reads core settings (site name, etc.) and writes to plugin's own settings table. Reads media table to resolve OGP images and organization logo by media ID. Embeds external scripts to googletagmanager.com/google-analytics.com when GA is configured, with dynamic CSP directive registration."
        }
    },
    "declares": {
        "configs": {
            "roles": true,
            "database_cleanup": true,
            "navigation": true
        },
        "contracts": [
            "App\\Contracts\\CspPolicyProvider"
        ],
        "migrations": true,
        "commands": false,
        "middleware": true
    },
